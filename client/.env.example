# Google Maps JavaScript API key.
# NOTE: Vite inlines VITE_* variables into the client bundle at build time —
# this key is publicly visible to anyone who inspects the deployed site.
# Protect it with HTTP referrer restrictions in Google Cloud Console
# (restrict to your domain + localhost, and to the Maps JavaScript API only),
# not by keeping it secret.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
